    },

    "direct": [],

    "opsListen": { "host": "127.0.0.1", "port": 8439 },
    "opsClients": [],

    "sessionTtlSeconds": 300,

    "i2p": { "privacy": "minimal", "logLevel": "none" },
    "pools": { "stream": 4, "call": 2, "watch": 2 },

    "logLevel": "info",

    "serverName": "nginx",
    "notFound": ""
}
