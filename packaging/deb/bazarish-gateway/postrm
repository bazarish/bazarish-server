#!/bin/sh
# Bazarish project (c) 2026
# Even a purge leaves /etc/bazarish/gateway.json and /var/lib/bazarish: the path
# and the token are what clients were given, and only the operator removes them.
set -e

if [ "$1" = "purge" ]; then
    rm -f /etc/systemd/system/multi-user.target.wants/bazarish-gateway.service
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
