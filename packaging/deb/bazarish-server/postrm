#!/bin/sh
# Bazarish project (c) 2026
# A purge leaves /etc/bazarish and /var/lib/bazarish: the keys, accounts and mail stay.
set -e

if [ "$1" = "purge" ]; then
    for unit in bazarish-server bazarish-service-node bazarish-facade bazarish-admin-panel; do
        rm -f "/etc/systemd/system/multi-user.target.wants/$unit.service"
    done
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
