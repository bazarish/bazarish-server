[Unit]
Description=Bazarish gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bazarish
Group=bazarish
ExecStart=/usr/lib/bazarish-gateway/bazarish-gateway --config /etc/bazarish/gateway.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# The daemon keeps its state here and writes the settings it is given into its config.
StateDirectory=bazarish
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/bazarish /etc/bazarish

[Install]
WantedBy=multi-user.target
