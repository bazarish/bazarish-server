#!/bin/sh
# Bazarish project (c) 2026
# A purge leaves gateway.json and /var/lib/bazarish: clients were given its path and token.
set -e

if [ "$1" = "purge" ]; then
    rm -f /etc/systemd/system/multi-user.target.wants/bazarish-gateway.service
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
