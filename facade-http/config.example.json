{
  // What the facade's own I2P destination relays to, on loopback.
  "listen": {"host": "127.0.0.1", "port": 8419},
  // A TLS socket carrying exactly what the I2P destination carries, for a
  // gateway the operator has given a route to this address. Left out, the only
  // way in is the destination.
  "directListen": {"host": "0.0.0.0", "port": 8418},
  // A private socket serving the operator-signed health, settings and restart
  // for the admin panel. Never published to clients.
  "opsListen": {"host": "127.0.0.1", "port": 8429},
  // The only backend: the messaging server, which carries the sealed tunnel.
  // "pin" is the key it prints when it starts.
  "messaging": {"host": "127.0.0.1", "port": 8420, "pin": ""},
  "operators": [],
  // The keys allowed to open the ops socket (the panel's).
  "opsClients": [],
  // Its destination key, minted at the first start: the facade's address.
  "state": "/var/lib/bazarish/facade",
  "i2p": {"privacy": "minimal", "tunnelQuantity": 16},
  "logLevel": "info"
}
