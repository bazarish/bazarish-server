#!/bin/sh
# Bazarish project (c) 2026
# The configs and the state are the operator's: bazarish-setup writes them on the
# first install and leaves them alone from then on. The user and the directories
# come with bazarish-gateway, which is configured first.
set -e

readonly kUnits="bazarish-server.service bazarish-service-node.service \
bazarish-facade.service bazarish-admin-panel.service"

if [ "$1" = "configure" ]; then
    notice=$(runuser -u bazarish -- /usr/lib/bazarish-server/bazarish-setup)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable $kUnits >/dev/null
        systemctl restart $kUnits
        if [ -n "$notice" ]; then
            systemctl restart bazarish-gateway.service
        fi
    fi
    if [ -n "$notice" ]; then
        printf '%s\n' "$notice"
    fi
fi
