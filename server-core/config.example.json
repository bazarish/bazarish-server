{
  // Keys and stored content; the server card is written here on first start.
  "state": "/var/lib/bazarish/server-core",
  // The sealed tunnel and federation. TLS, with the certificate this server
  // makes in its state directory on first start.
  "listen": {"host": "127.0.0.1", "port": 8420},
  // The operator's socket: health, settings, restart, quotas, destinations.
  // Nothing a client speaks is here.
  "opsListen": {"host": "127.0.0.1", "port": 8428},
  // Who may call the operator endpoints: the service node and the admin panel.
  "operators": [],
  // The keys allowed to open the operator's socket, printed by the panel and by
  // the node when they start.
  "opsClients": [],
  // The local service node, for first-contact card fetches by fingerprint.
  "serviceNode": {"url": "https://127.0.0.1:8421", "pin": ""},
  "i2p": {
    "enabled": true,
    "privacy": "max",
    "tunnelQuantity": 5,
    "log": false
  },
  // Inbound deliveries per peer destination per 60s (0 disables).
  "federationRateLimit": 240,
  "logLevel": "info"
}
