{
  // Where this node keeps its identity and its records.
  "state": "/var/lib/bazarish/service-node",
  // The card of the messaging server this node belongs to.
  "serverCard": "/var/lib/bazarish/server-core/server-card.der",
  "listen": {"host": "127.0.0.1", "port": 8421},
  // The messaging server's private channel, for the pushes this node owes it.
  "messaging": {"host": "127.0.0.1", "port": 8420},
  // Who may call the operator endpoints (the admin panel).
  "operators": [],
  "logLevel": "info",

  // What a new account gets.
  "freeStorageBytes": 52428800,

  "portal": {
    "listen": {"host": "0.0.0.0", "port": 8431},
    "assets": "/opt/bazarish/bazarish-server/service-node/portal",
    "message": "Sign in with your key to register.",
    // What the portal calls itself and where users open it. A client shows these
    // words before it signs a login, and the user compares them with the address
    // bar, so "address" has to be the address they actually opened. Left out,
    // the name is "Bazarish service node" and the address is the first link
    // below - and with no links either, the portal refuses to start.
    "name": "",
    "address": "",
    "links": [],
    "facades": []
  },

  "registration": {
    "requireApproval": false,
    "message": "",
    "ttlDays": 7
  }
}
