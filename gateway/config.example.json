{
    "listen": { "host": "127.0.0.1", "port": 8431 },

    "basePath": "/CHANGE-ME-to-something-nobody-guesses",
    "token": "CHANGE-ME-to-a-long-random-string",
    "publicAddress": "https://gateway.example",

    "state": "/var/lib/bazarish/gateway",

    "reseed": [],

